{
    "name": "duyler/package",
    "description": "Powerful PHP package",
    "keywords": [
        "package"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mikhail Ilinsky",
            "email": "mail@milinsky.ru"
        }
    ],
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.80",
        "vimeo/psalm": "^6.10",
        "rector/rector": "^2.3",
        "infection/infection": "^0.32.0"
    },
    "autoload": {
        "psr-4": {
            "Duyler\\Package\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Duyler\\Package\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
